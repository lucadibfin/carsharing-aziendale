# Copiare in .env (mai committare .env). Tutti i segreti vanno generati per ogni ambiente.

NODE_ENV=development
PORT=3000
# Origine pubblica dell'app (usata per link d'invito, CORS e cookie)
APP_ORIGIN=http://localhost:4200

# Database (sviluppo: PostgreSQL embedded avviato con `npm run db:start`)
DATABASE_URL=postgresql://fcs:fcs_dev_only@localhost:5433/fcs

# --- Autenticazione ---
# mock | corporate
AUTH_PROVIDER=mock
# Solo per AUTH_PROVIDER=corporate. Deve essere https://
CORPORATE_AUTH_URL=
CORPORATE_AUTH_TIMEOUT_MS=8000
# Verifica dipendenti usciti: nightly | session-expiry | both
EMPLOYEE_CHECK_MODE=session-expiry
SESSION_MAX_DAYS=14
SESSION_IDLE_DAYS=7
# Primo admin globale (username AD)
INITIAL_GLOBAL_ADMIN=

# Anti brute-force (più restrittivo della policy di blocco AD)
LOGIN_MAX_FAILURES_PER_USER=3
LOGIN_MAX_FAILURES_PER_IP=20
# Blocco temporaneo dopo troppi errori: si toglie da solo dopo LOGIN_LOCK_MINUTES.
LOGIN_LOCK_MINUTES=15
# Se > LOGIN_LOCK_MINUTES il blocco raddoppia a ogni ulteriore errore fino a questo massimo.
LOGIN_LOCK_MAX_MINUTES=15
LOGIN_FAILURES_RESET_HOURS=24

# --- Segreti (generare con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ---
# Chiave AES-256-GCM per la cifratura dei dati a riposo (32 byte in base64). Formato: <versione>:<chiave>[,<versione>:<chiave>]
DATA_ENCRYPTION_KEYS=1:REPLACE_ME_WITH_32_BYTES_BASE64
# Chiave HMAC per pseudonimizzare identificativi nei log e nei contatori anti brute-force
HMAC_KEY=REPLACE_ME_WITH_32_BYTES_BASE64

# --- Web Push (generare con: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Apple rifiuta le push se il subject non è un indirizzo plausibile: usare una casella reale del team.
VAPID_SUBJECT=mailto:mobility@example.invalid
# Proxy aziendale per raggiungere i servizi push (Google, Apple, Mozilla); vuoto = connessione diretta.
PUSH_HTTPS_PROXY=

# --- Email (solo notifiche e codici di verifica; l'indirizzo lo inserisce l'utente) ---
# MAIL_TRANSPORT: smtp | outbox | disabled. In sviluppo "outbox" scrive le email come file JSON
# in MAIL_OUTBOX_DIR invece di spedirle (così si leggono i codici di verifica). In produzione solo smtp.
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=.mail-outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Car Sharing <noreply@example.invalid>"

# --- Distanze per le statistiche (vedi docs/distanze.md) ---
# estimate = linea d'aria x coefficiente (nessun servizio); osrm = OSRM self-hosted
ROUTING_PROVIDER=estimate
OSRM_URL=
ROUTING_TIMEOUT_MS=5000

LOG_LEVEL=info
