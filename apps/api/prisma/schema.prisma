// Schema dati dell'app di car sharing.
// Privacy by design: nessun indirizzo di residenza, nessuna coordinata degli utenti.
// I campi *Enc contengono dati cifrati a livello applicativo (AES-256-GCM).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

enum Role {
  SITE_ADMIN
  GLOBAL_ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  PENDING_DELETION
}

enum TripVisibility {
  PUBLIC
  PRIVATE
}

enum TripStatus {
  SCHEDULED
  AWAITING_CLOSURE
  CLOSED
  CANCELLED
}

enum ParticipantStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  WAITLISTED
  NOT_THERE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum InvitationScope {
  TRIP
  SERIES
}

enum FuelType {
  PETROL
  DIESEL
  LPG
  METHANE
  HYBRID
  ELECTRIC
}

enum ChatMessageKind {
  TEXT
  QUICK
  SYSTEM
}

enum PolicyType {
  PRIVACY_NOTICE
  TERMS
}

enum AbsenceReportStatus {
  /// In attesa di un admin.
  OPEN
  /// Esaminata, nessun seguito.
  DISMISSED
  /// Esaminata e presa in carico (eventuali azioni fuori dall'app, decise da una persona).
  ACKNOWLEDGED
}

enum DistanceSource {
  /// Distanza stradale calcolata dal servizio di routing (OSRM self-hosted).
  ROUTED
  /// Stima: distanza in linea d'aria × coefficiente stradale.
  ESTIMATED
}

enum TripFactStatus {
  PROPOSED
  COMPLETED
  CANCELLED
}

enum StatRole {
  DRIVER
  PASSENGER
}

// ---------------------------------------------------------------------------
// Dati di riferimento (pubblici)
// ---------------------------------------------------------------------------

/// Comuni italiani (elenco ISTAT). Le coordinate sono del centroide/municipio,
/// dato pubblico usato solo per il calcolo delle distanze tra comuni e sedi.
model Comune {
  istat     String  @id @db.Char(6)
  name      String
  province  String  @db.VarChar(2)
  region    String
  lat       Float?
  lon       Float?
  active    Boolean @default(true)

  stops     TripStop[]

  @@index([name])
}

/// Sede aziendale.
model Site {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  address     String
  comuneIstat String   @db.Char(6)
  lat         Float?
  lon         Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]
  roles       RoleAssignment[]
  series      TripSeries[]
  distances   DistanceCache[]
}

/// Cache delle distanze stradali comune → sede. Solo dati pubblici: nessun
/// indirizzo o posizione degli utenti.
model DistanceCache {
  comuneIstat String         @db.Char(6)
  siteId      String         @db.Uuid
  meters      Int
  source      DistanceSource
  computedAt  DateTime

  site        Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([comuneIstat, siteId])
}

// ---------------------------------------------------------------------------
// Utenti, ruoli, consensi
// ---------------------------------------------------------------------------

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  /// Username AD normalizzato (minuscolo). Identificativo stabile dell'utente.
  username            String     @unique
  firstName           String
  lastName            String
  status              UserStatus @default(ACTIVE)
  siteId              String?    @db.Uuid
  comuneIstat         String?    @db.Char(6)
  /// Telefono cifrato (facoltativo).
  phoneEnc            String?
  /// Email per le notifiche (aziendale o personale), cifrata. Solo indirizzi verificati
  /// con codice; non serve per il login.
  emailEnc            String?
  emailVerifiedAt     DateTime?
  fuelType            FuelType?
  consumptionPer100km Float?
  /// Completamento dell'onboarding (informativa, termini e profilo minimo).
  onboardedAt         DateTime?
  lastLoginAt         DateTime?
  lastVerifiedAt      DateTime?
  deactivatedAt       DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  site                Site?      @relation(fields: [siteId], references: [id])
  consent             UserConsent?
  roles               RoleAssignment[]
  sessions            Session[]
  policyAcceptances   PolicyAcceptance[]
  drivenSeries        TripSeries[]       @relation("SeriesDriver")
  participations      TripParticipant[]
  invitationsReceived Invitation[]       @relation("Invitee")
  invitationsCreated  Invitation[]       @relation("InvitationCreator")
  chatMessages        ChatMessage[]
  chatMutes           ChatMute[]
  pushSubscriptions   PushSubscription[]
  emailVerification   EmailVerification?
  statEntries         UserStatEntry[]
  favorites           Favorite[]         @relation("FavoriteOwner")
  favoritedBy         Favorite[]         @relation("FavoriteTarget")
  reportsMade         AbsenceReport[]    @relation("ReportReporter")
  reportsReceived     AbsenceReport[]    @relation("ReportReported")
  reportsHandled      AbsenceReport[]    @relation("ReportHandler")

  @@index([lastName, firstName])
}

/// Verifica in corso di un nuovo indirizzo email (al massimo una per utente).
/// L'indirizzo diventa effettivo solo dopo l'inserimento del codice ricevuto.
model EmailVerification {
  userId      String   @id @db.Uuid
  /// Indirizzo da verificare, cifrato.
  emailEnc    String
  /// HMAC del codice a 6 cifre: il codice in chiaro non è salvato.
  codeHash    String
  expiresAt   DateTime
  /// Tentativi errati sul codice corrente.
  attempts    Int      @default(0)
  /// Invii nella finestra corrente (limite anti abuso).
  sendCount   Int      @default(1)
  windowStart DateTime
  lastSentAt  DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Consensi facoltativi: separati, non preselezionati, revocabili.
/// Ogni modifica è anche registrata in ConsentEvent (storico).
model UserConsent {
  userId             String   @id @db.Uuid
  phoneVisible       Boolean  @default(false)
  discoverable       Boolean  @default(false)
  optionalNotifications Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Storico dei consensi (prova del consenso, art. 7 par. 1 GDPR).
model ConsentEvent {
  id        BigInt   @id @default(autoincrement())
  userId    String   @db.Uuid
  consent   String
  granted   Boolean
  createdAt DateTime @default(now())

  @@index([userId])
}

model RoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      Role
  /// Valorizzato solo per SITE_ADMIN.
  siteId    String?  @db.Uuid
  grantedBy String?  @db.Uuid
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site?    @relation(fields: [siteId], references: [id])

  @@unique([userId, role, siteId])
}

// ---------------------------------------------------------------------------
// Autenticazione
// ---------------------------------------------------------------------------

/// Sessione applicativa lato server. Il cookie contiene un token casuale;
/// nel DB si salva solo il suo hash SHA-256.
model Session {
  id                String   @id @default(uuid()) @db.Uuid
  tokenHash         String   @unique
  userId            String   @db.Uuid
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([absoluteExpiresAt])
}

/// Contatori anti brute-force. key = "u:" + HMAC(username) oppure "ip:" + HMAC(ip).
/// Nessun dato in chiaro.
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Informativa e termini (versionati)
// ---------------------------------------------------------------------------

model PolicyDocument {
  id          String     @id @default(uuid()) @db.Uuid
  type        PolicyType
  version     Int
  title       String
  /// Testo in Markdown.
  content     String
  publishedAt DateTime   @default(now())
  createdBy   String?    @db.Uuid

  acceptances PolicyAcceptance[]

  @@unique([type, version])
}

model PolicyAcceptance {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  documentId String         @db.Uuid
  acceptedAt DateTime       @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   PolicyDocument @relation(fields: [documentId], references: [id])

  @@unique([userId, documentId])
}

// ---------------------------------------------------------------------------
// Viaggi
// ---------------------------------------------------------------------------

/// Serie di viaggi. Un viaggio singolo è una serie con una sola occorrenza.
model TripSeries {
  id           String         @id @default(uuid()) @db.Uuid
  driverId     String         @db.Uuid
  siteId       String         @db.Uuid
  visibility   TripVisibility
  /// Giorni ISO della settimana (1=lun..7=dom) per le serie ricorrenti; vuoto = viaggio singolo.
  weekdays     Int[]          @default([])
  startDate    DateTime       @db.Date
  endDate      DateTime?      @db.Date
  arrivalTime  String         @db.VarChar(5)
  returnTime   String?        @db.VarChar(5)
  seats        Int
  meetingPoint String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  driver       User           @relation("SeriesDriver", fields: [driverId], references: [id])
  site         Site           @relation(fields: [siteId], references: [id])
  stops        TripStop[]
  trips        Trip[]
  invitations  Invitation[]
  chatMessages ChatMessage[]
  chatMutes    ChatMute[]

  @@index([driverId])
}

/// Comuni del percorso, ordinati (order 0 = comune di partenza).
model TripStop {
  id          String     @id @default(uuid()) @db.Uuid
  seriesId    String     @db.Uuid
  order       Int
  comuneIstat String     @db.Char(6)

  series      TripSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  comune      Comune     @relation(fields: [comuneIstat], references: [istat])

  @@unique([seriesId, order])
  @@index([comuneIstat])
}

/// Singola occorrenza (una data) di una serie.
model Trip {
  id                 String          @id @default(uuid()) @db.Uuid
  seriesId           String          @db.Uuid
  siteId             String          @db.Uuid
  date               DateTime        @db.Date
  arrivalTime        String          @db.VarChar(5)
  returnTime         String?         @db.VarChar(5)
  /// Istante (UTC) di arrivo in ufficio, calcolato da data + orario Europe/Rome.
  arrivalAt          DateTime
  seats              Int
  /// Se valorizzato, prevale sulla visibilità della serie per questa data.
  visibilityOverride TripVisibility?
  status             TripStatus      @default(SCHEDULED)
  cancelledAt        DateTime?
  closedAt           DateTime?
  /// Avviso "nuovo viaggio di un preferito" già inviato (una sola volta per viaggio).
  favoritesNotifiedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  series             TripSeries      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  participants       TripParticipant[]
  invitations        Invitation[]
  statFact           TripStatFact?
  absenceReports     AbsenceReport[]

  @@unique([seriesId, date])
  @@index([siteId, date])
  @@index([status, arrivalAt])
}

model TripParticipant {
  id             String            @id @default(uuid()) @db.Uuid
  tripId         String            @db.Uuid
  userId         String            @db.Uuid
  status         ParticipantStatus
  boardingComune String            @db.Char(6)
  requestedAt    DateTime          @default(now())
  decidedAt      DateTime?
  cancelledAt    DateTime?
  /// true se la cancellazione è avvenuta oltre la scadenza.
  lateCancel     Boolean           @default(false)
  attended       Boolean?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  trip           Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  seriesId      String           @db.Uuid
  /// Null se l'invito vale per l'intera serie.
  tripId        String?          @db.Uuid
  scope         InvitationScope
  status        InvitationStatus @default(PENDING)
  createdById   String           @db.Uuid
  /// Invito diretto a un utente registrato.
  inviteeId     String?          @db.Uuid
  /// Invito tramite link: si salva solo l'hash del token.
  tokenHash     String?          @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())

  series        TripSeries       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  trip          Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy     User             @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  invitee       User?            @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([expiresAt])
}

/// Colleghi preferiti. Visibile solo a chi crea la lista: il collega non sa
/// di essere tra i preferiti di qualcuno.
model Favorite {
  userId         String   @db.Uuid
  favoriteUserId String   @db.Uuid
  createdAt      DateTime @default(now())

  user           User     @relation("FavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  favorite       User     @relation("FavoriteTarget", fields: [favoriteUserId], references: [id], onDelete: Cascade)

  @@id([userId, favoriteUserId])
  @@index([favoriteUserId])
}

/// Segnalazione di mancata presentazione (o cancellazione oltre la scadenza).
/// Non visibile agli altri utenti; gestita solo dagli admin, senza alcuna
/// conseguenza automatica. Cancellata dopo absenceReportRetentionMonths.
model AbsenceReport {
  id              String              @id @default(uuid()) @db.Uuid
  /// Null se il viaggio è stato cancellato (restano sede e data per la gestione).
  tripId          String?             @db.Uuid
  siteId          String              @db.Uuid
  tripDate        DateTime            @db.Date
  /// Null se chi ha segnalato ha cancellato l'account.
  reporterId      String?             @db.Uuid
  reportedId      String              @db.Uuid
  /// Motivazione obbligatoria, cifrata.
  reasonEnc       String
  status          AbsenceReportStatus @default(OPEN)
  /// Nota dell'admin sulla decisione, cifrata.
  decisionNoteEnc String?
  handledById     String?             @db.Uuid
  handledAt       DateTime?
  createdAt       DateTime            @default(now())

  trip            Trip?               @relation(fields: [tripId], references: [id], onDelete: SetNull)
  reporter        User?               @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reported        User                @relation("ReportReported", fields: [reportedId], references: [id], onDelete: Cascade)
  handledBy       User?               @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@unique([tripId, reporterId, reportedId])
  @@index([siteId, status])
  @@index([reportedId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Statistiche
// ---------------------------------------------------------------------------

/// Fatto statistico ANONIMO di un viaggio, per i report aggregati (PSCL).
/// Nessun riferimento a utenti: resta anche dopo la cancellazione degli account.
/// tripId serve solo ad aggiornare la riga finché il viaggio esiste; quando il
/// viaggio viene cancellato diventa null (ON DELETE SET NULL).
model TripStatFact {
  id          String         @id @default(uuid()) @db.Uuid
  tripId      String?        @unique @db.Uuid
  siteId      String         @db.Uuid
  date        DateTime       @db.Date
  visibility  TripVisibility
  status      TripFactStatus
  seats       Int
  /// Passeggeri presenti (solo viaggi completati).
  passengers  Int            @default(0)
  /// 1 = solo andata, 2 = andata e ritorno.
  legs        Int            @default(1)
  driverKm    Float?
  /// Km in auto evitati dai passeggeri (ognuno avrebbe guidato da solo).
  kmAvoided   Float?
  co2SavedKg  Float?
  fuelSaved   Float?
  /// L, kg o kWh secondo l'alimentazione.
  fuelUnit    String?
  eurSaved    Float?
  /// true se almeno una distanza è stimata (linea d'aria) invece che calcolata.
  estimated   Boolean        @default(false)
  /// false se mancavano le coordinate di un comune o della sede (metriche nulle).
  complete    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  trip        Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([siteId, date])
  @@index([date])
}

/// Statistiche personali (una riga per viaggio completato), calcolate alla
/// chiusura e indipendenti dal viaggio: restano se il viaggio viene cancellato,
/// si cancellano con l'account.
model UserStatEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  date        DateTime @db.Date
  role        StatRole
  /// Km percorsi insieme ad altri colleghi.
  sharedKm    Float
  /// Passeggero: km che avrebbe guidato da solo. Conducente: somma di quelli dei suoi passeggeri.
  kmAvoided   Float
  co2SavedKg  Float
  fuelSaved   Float
  fuelUnit    String
  eurSaved    Float
  estimated   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ---------------------------------------------------------------------------
// Chat e notifiche
// ---------------------------------------------------------------------------

/// Una chat per serie; i messaggi sono raggruppati per data del viaggio.
model ChatMessage {
  id        String          @id @default(uuid()) @db.Uuid
  seriesId  String          @db.Uuid
  tripDate  DateTime        @db.Date
  senderId  String?         @db.Uuid
  kind      ChatMessageKind
  /// Testo cifrato (solo per kind = TEXT o SYSTEM).
  bodyEnc   String?
  quickCode String?
  createdAt DateTime        @default(now())

  series    TripSeries      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  sender    User?           @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([seriesId, createdAt])
  @@index([createdAt])
}

model ChatMute {
  userId    String     @db.Uuid
  seriesId  String     @db.Uuid
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    TripSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Configurazione
// ---------------------------------------------------------------------------

/// Registro immutabile (append-only) degli accessi e delle azioni degli admin
/// sui dati personali e delle operazioni rilevanti per il GDPR.
/// UPDATE, DELETE e TRUNCATE sono vietati da trigger (migrazione audit_log).
/// Catena di hash: hash = SHA-256(prevHash + contenuto canonico) → manomissioni rilevabili.
/// Nessun dato personale in chiaro: solo identificativi (UUID) e codici di azione.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  /// Utente che ha compiuto l'azione (null = sistema, es. job notturni).
  actorId    String?  @db.Uuid
  action     String
  targetType String?
  targetId   String?
  /// Dettagli non personali (filtri usati, campi modificati, esiti).
  meta       Json?
  prevHash   String
  hash       String   @unique

  @@index([at])
  @@index([actorId])
  @@index([targetType, targetId])
}

/// Parametri configurabili dagli admin. value è validato da schema zod lato API.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid
}
