# API NestJS — build multi-stage dal monorepo (contesto: radice del repository)
FROM node:22-alpine AS build
WORKDIR /repo
RUN npm install -g npm@11
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @fcs/shared --workspace api --include-workspace-root --no-audit --no-fund
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm run build -w @fcs/shared && npm run build -w api

# Immagine usata dal servizio "migrate" (prisma migrate deploy + seed)
FROM build AS migrate
WORKDIR /repo/apps/api
CMD ["sh", "-c", "npx prisma migrate deploy && node prisma/seed.mjs"]

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /repo
RUN npm install -g npm@11
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @fcs/shared --workspace api --include-workspace-root --omit=dev --no-audit --no-fund \
  && npm cache clean --force
COPY --from=build /repo/packages/shared/dist packages/shared/dist
COPY --from=build /repo/apps/api/dist apps/api/dist
WORKDIR /repo/apps/api
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]
