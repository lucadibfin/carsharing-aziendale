# Frontend Angular (PWA) servito da Caddy, che fa anche da reverse proxy verso l'API.
FROM node:22-alpine AS build
WORKDIR /repo
RUN npm install -g npm@11
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @fcs/shared --workspace web --include-workspace-root --no-audit --no-fund
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build -w @fcs/shared && npm run build -w web

FROM caddy:2-alpine
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/apps/web/dist/web/browser /srv
