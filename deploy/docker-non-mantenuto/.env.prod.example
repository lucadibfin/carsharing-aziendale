# Copiare in deploy/docker-non-mantenuto/.env.prod (NON committare). Generare segreti nuovi per la produzione:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   npx web-push generate-vapid-keys

APP_DOMAIN=carsharing.example.invalid
APP_ORIGIN=https://carsharing.example.invalid
# Vuoto = certificato automatico; su rete interna: tls /certs/fullchain.pem /certs/privkey.pem
TLS_CONFIG=

DB_PASSWORD=

AUTH_PROVIDER=corporate
CORPORATE_AUTH_URL=https://
CORPORATE_CHECK_URL=
CORPORATE_AUTH_TIMEOUT_MS=8000
EMPLOYEE_CHECK_MODE=session-expiry
SESSION_MAX_DAYS=14
SESSION_IDLE_DAYS=7
INITIAL_GLOBAL_ADMIN=

LOGIN_MAX_FAILURES_PER_USER=3
LOGIN_MAX_FAILURES_PER_IP=20
# Blocco temporaneo dopo troppi errori: si toglie da solo dopo LOGIN_LOCK_MINUTES.
LOGIN_LOCK_MINUTES=15
# Se > LOGIN_LOCK_MINUTES il blocco raddoppia a ogni ulteriore errore fino a questo massimo.
LOGIN_LOCK_MAX_MINUTES=15
LOGIN_FAILURES_RESET_HOURS=24

DATA_ENCRYPTION_KEYS=1:
HMAC_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mobility@example.invalid

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.invalid
BRAND=default

LOG_LEVEL=info
